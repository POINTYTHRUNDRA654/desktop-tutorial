{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist-electron",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": [
    "src/electron/**/*",
    "src/shared/**/*",
    "src/mining/**/*"
  ],
  "exclude": [
    "node_modules",
    "src/renderer",
    "src/electron/__tests__"
  ]
}
