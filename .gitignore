*.sqlite3

# Brain B local build outputs (ChromaDB dirs + manifest, SQLite episodic memory) — never
# committed; these are build artifacts, not source. Default paths live outside the repo
# entirely (D:\Mossy-AI), but ignored here too as a safety net in case CHROMA_CURATED_PATH /
# CHROMA_RUNTIME_PATH / MOSSY_BASE_DIR ever get pointed at a repo-relative path (e.g. a
# non-Windows contributor overriding the Windows-only default). Committed knowledge SOURCE
# lives in brain-b/knowledge/**/*.jsonl instead — see /LICENSING.md.
brain-b/chroma_curated/
brain-b/chroma_runtime/
brain-b/data/
brain-b/*.bin

# Third-party tools cloned into the project root for local reference/use — each has its own
# .git and license, not MOSSY.SPACE source. Found sitting untracked in the working tree
# 2026-08-15; never committed, but not excluded either, so a careless `git add -A` would have
# swept them in.
/krita-ai-diffusion/
/superpowers/

# Nexus Mods upload staging (compiled installer .exe/.zip) — local release workflow only,
# never source, never committed.
/nexus_upload_v*/

# Nexus edition build artifacts — all reproducible from build_nexus_package.py +
# the same committed knowledge/**/*.jsonl source of truth. Never hand-edit or commit;
# a released build's assets go through GitHub Releases (or equivalent), not git.
brain-b/nexus/.venv-test/
brain-b/nexus/build/
brain-b/nexus/dist/
brain-b/nexus/dist-package/
brain-b/nexus/pyinstaller-build/
brain-b/nexus/*.spec
brain-b/nexus/*.env
brain-b/nexus/.env
# Copied fresh from ../retrieval_tuning.py by build_nexus_package.py on every
# build — the single source of truth lives at brain-b/retrieval_tuning.py.
# Never hand-edit or commit this copy.
brain-b/nexus/retrieval_tuning.py
# Built release binary + checksum manifest — 200+MB, hosted as GitHub Release assets
# (see build_nexus_package.py), never as git blobs. GitHub hard-blocks files >100MB
# via plain git push anyway; Git LFS is not set up on this repo and isn't needed here
# since the release-asset path already solves large-file distribution.
brain-b/nexus/*.zip
brain-b/nexus/*.manifest.json

