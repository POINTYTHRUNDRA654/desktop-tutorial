# Copy this file to .env (same directory) and fill in your real value.
# .env is already covered by the repo's root .gitignore — never commit a real one.
#
# This is a SEPARATE process from the Electron app, with its own environment — the
# app's own backend token (encrypted in its settings.json via safeStorage) is not
# readable here.
#
# MOSSY_BACKEND_TOKEN authenticates against Mossy's shared Render backend
# (mossy.onrender.com/v1/chat — the same proxy the Electron app itself calls), which
# holds the real Groq API key server-side. This is NOT a Groq key — it must match
# MOSSY_API_TOKEN configured on the Render service itself.

MOSSY_BACKEND_TOKEN=
# MOSSY_BACKEND_URL=https://mossy.onrender.com

# Optional override — uncomment to use:
# BRAINB_GENERATION_BACKEND=cloud
